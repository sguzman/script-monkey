{
  "manifest_version": 3,
  "name": "ChatGPT Tab Signal",
  "version": "0.1.13",
  "description": "Automatic ChatGPT response alerts and conversation tab favicon states.",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "offscreen",
    "scripting",
    "tabs",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
