{
  "manifest_version": 3,
  "name": "ChatGPT Tab Signal",
  "version": "0.1.8",
  "description": "One global switch; lazily notify on completed ChatGPT responses across tabs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "offscreen",
    "scripting",
    "tabs",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ChatGPT Tab Signal",
    "default_popup": "popup.html"
  }
}
