{
  "manifest_version": 3,
  "name": "ChatGPT Tab Signal",
  "version": "0.1.29",
  "description": "Automatic ChatGPT response alerts, deterministic conversation favicon colors and response status titles.",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "offscreen",
    "scripting",
    "tabs",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/c/*",
        "https://chatgpt.com/g/*/c/*"
      ],
      "js": [
        "conversation-color.js",
        "chat-color-title.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
