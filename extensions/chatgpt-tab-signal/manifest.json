{
  "manifest_version": 3,
  "name": "ChatGPT Tab Signal",
  "version": "0.1.4",
  "description": "Per-tab ChatGPT generation and unread indicators with completion chime and desktop notification.",
  "minimum_chrome_version": "116",
  "permissions": [
    "notifications",
    "offscreen",
    "scripting",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ChatGPT Tab Signal",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
